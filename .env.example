# Product config: copy to .env.local, then set ENV_FILE=.env.local.
# Preserve any populated .env containing historical harness credentials.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
APP_BASE_URL=http://127.0.0.1:5173
WEB_DIST_DIR=web/dist
DATABASE_URL=postgres://pause@127.0.0.1:55432/pause?sslmode=disable
# Required: base64 encoding of 32 random bytes. Keep stable across restarts.
MESSAGE_ENCRYPTION_KEY=
# Server allowlist: one controlled sandbox merchant. P01 performs no payment.
PAYPAL_MERCHANT_ID=
PAYPAL_MERCHANT_LABEL=Pause Sandbox Store
MAX_AMOUNT_MINOR=500000
MESSAGE_RETENTION_HOURS=168
OPERATION_RETENTION_HOURS=24

# Reserved for P02; no credentials needed to save P01 intake records.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Private inference scaffold; no generative LLM variables required.
# Optional in P01; setting the URL requires a >=32-character service token.
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
CLASSIFIER_MANIFEST_PATH=models/classifier.manifest.json
ENCODER_MANIFEST_PATH=models/encoder.manifest.json
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_PLAYBOOK_ALIAS=pause-playbooks
ELASTICSEARCH_HISTORY_ALIAS=pause-request-history

# Explicit development command only; never seeded during normal startup.
SEED_PASSWORD=
# Tests create/drop only their own randomly named schema.
TEST_DATABASE_URL=postgres://pause@127.0.0.1:55432/pause?sslmode=disable
