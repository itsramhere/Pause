# Copy to .env in the repository root. Never commit the populated file.
APP_ENV=demo
APP_BASE_URL=http://127.0.0.1:8787
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox BUSINESS merchant/account ID associated with the REST app.
PAYPAL_MERCHANT_ID=
PAYPAL_MERCHANT_LABEL=Pause Sandbox Store
# Leave empty until a real HTTPS app webhook has been registered (P02).
PAYPAL_WEBHOOK_ID=

# Optional legacy external-model experiment only. Not a Pause prerequisite.
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800

# Revised ML/Elastic probes need no LLM key. Keep all credentials server-side.
# P01 service/manifests; the P00 CLI trains and loads its own local artifacts.
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
CLASSIFIER_MANIFEST_PATH=
ENCODER_MANIFEST_PATH=
# Use a dedicated test cluster. HTTPS is required outside loopback.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Optional PEM CA bundle for a self-managed HTTPS cluster.
ELASTICSEARCH_CA_CERT=
ELASTICSEARCH_PLAYBOOK_ALIAS=pause-playbooks
ELASTICSEARCH_HISTORY_ALIAS=pause-request-history
ELASTICSEARCH_TIMEOUT_SECONDS=20

# P01 prerequisites; unused by the disposable P00 spike.
DATABASE_URL=
# Generate separate random keys during P01; do not reuse API credentials.
SESSION_KEY=
MESSAGE_ENCRYPTION_KEY=

# Local spike state and sanitized receipts, relative to the repository root.
SPIKE_EVIDENCE_DIR=planning/evidence/P00
SPIKE_DEADLINE_MINUTES=30
