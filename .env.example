# Product config: copy to .env.local, then set ENV_FILE=.env.local.
# Preserve any populated .env containing historical harness credentials.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
APP_BASE_URL=http://127.0.0.1:5173
WEB_DIST_DIR=web/dist
DATABASE_URL=postgres://pause@127.0.0.1:55432/pause?sslmode=disable
# Required: base64 encoding of 32 random bytes. Keep stable across restarts.
MESSAGE_ENCRYPTION_KEY=
# Server allowlist: one controlled sandbox merchant. No arbitrary recipients.
PAYPAL_MERCHANT_ID=
PAYPAL_MERCHANT_LABEL=Pause Sandbox Store
MAX_AMOUNT_MINOR=500000
MESSAGE_RETENTION_HOURS=168
OPERATION_RETENTION_HOURS=24

# Optional for intake only. Paired credentials enable sandbox authorization/void.
# Live hosts are rejected. Client ID is public SDK configuration; secret stays server-side.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Real app webhook ID; postback verification does not accept simulator WEBHOOK_ID.

# Private approved inference; no generative LLM variables required.
# URLs optional for intake/cancel only; release requires usable analysis.
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
CLASSIFIER_MANIFEST_PATH=models/classifier.manifest.json
ENCODER_MANIFEST_PATH=models/encoder.manifest.json
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CA_CERT=
ELASTICSEARCH_PLAYBOOK_ALIAS=pause-playbooks
ELASTICSEARCH_HISTORY_ALIAS=pause-request-history
PATTERN_REQUESTED_THRESHOLD_MINOR=100000
PATTERN_ESCALATION_MINIMUM_MINOR=10000
PATTERN_ESCALATION_MULTIPLIER=3

# Explicit development command only; never seeded during normal startup.
SEED_PASSWORD=
# Tests create/drop only their own randomly named schema.
TEST_DATABASE_URL=postgres://pause@127.0.0.1:55432/pause?sslmode=disable
# Optional isolated judge scenarios (disabled in production)
DEMO_ENABLED=0
