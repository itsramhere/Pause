# Historical P00 harness settings, loaded from the repository root .env.
# Preserve the populated root file; process environment takes precedence.
APP_ENV=demo
APP_BASE_URL=http://127.0.0.1:8787
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_MERCHANT_LABEL=Pause Sandbox Store
PAYPAL_WEBHOOK_ID=
SPIKE_EVIDENCE_DIR=data/spike-evidence
SPIKE_DEADLINE_MINUTES=30
# Only the explicitly invoked historical `ai` probe uses these settings.
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
